#!/bin/bash
################################################################################
IGNORE="$HOME/.bgit-ignore"

for dir in `ls -1`
do
    if [ -d $dir -a -d "$dir/.git" ]; then

        if [ -f $IGNORE ]; then
            FOUND=`grep $dir $IGNORE`
        fi

        if [ ! -n "$FOUND" ]; then
            echo "---> $dir <---" >&2;
            cd $dir;
            # git $1 "$2"
            git $*
            echo
            cd ..;
        fi
    fi
done
